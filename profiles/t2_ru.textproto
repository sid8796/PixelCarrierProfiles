canonical_name: "t2_ru"
version: 1
apns {
  apn {
    name: "T2 RU Internet"
    value: "internet"
    type: DEFAULT
    protocol: IPV4V6
    roaming_protocol: IPV4V6
  }
  apn {
    name: "T2 RU MMS"
    value: "mms"
    type: MMS
    mmsc: "http://mms"
    mmsc_proxy: "193.12.40.65"
    mmsc_proxy_port: "8080"
    protocol: IP
    roaming_protocol: IP
  }
  apn {
    name: "T2 RU IMS"
    value: "ims"
    type: IMS
    protocol: IPV4V6
    roaming_protocol: IPV4V6
    user_visible: false
  }
  apn {
    name: "T2 RU XCAP"
    value: "hos"
    type: XCAP
    protocol: IPV4V6
    roaming_protocol: IPV4V6
    user_visible: false
  }
}
configs {
  config { key: "carrier_volte_available_bool" bool_value: true }
  config { key: "carrier_wfc_ims_available_bool" bool_value: true }
  config { key: "carrier_vt_available_bool" bool_value: true }
  config { key: "carrier_supports_ss_over_ut_bool" bool_value: true }
  config { key: "show_4g_for_lte_data_icon_bool" bool_value: true }
  config { key: "hide_lte_plus_data_icon_bool" bool_value: false }
  config { key: "imssms.sms_over_ims_supported_bool" bool_value: true }
  config { key: "carrier_ussd_method_int" int_value: 1 }
  config { key: "imsss.ut_as_server_port_int" int_value: 80 }
  config { key: "bsf.bsf_server_port_int" int_value: 80 }
  config { key: "xcap_apn_name_string" text_value: "hos" }
  config { key: "imsss.ut_as_server_fqdn_string" text_value: "xcap.ims.mnc020.mcc250.pub.3gppnetwork.org" }
  config { key: "bsf.bsf_server_fqdn_string" text_value: "bsf.ims.mnc020.mcc250.pub.3gppnetwork.org" }
}
