canonical_name: "mts_by"
version: 1
apns {
  apn {
    name: "MTS BY Internet"
    value: "mts"
    type: DEFAULT
    type: SUPL
    user: "mts"
    password: "mts"
    authtype: 1
  }
  apn {
    name: "MTS BY MMS"
    value: "mts"
    type: MMS
    user: "mts"
    password: "mts"
    authtype: 1
    mmsc: "http://mmsc"
    mmsc_proxy: "192.168.192.168"
    mmsc_proxy_port: "8080"
  }
  apn {
    name: "MTS BY IMS"
    value: "ims"
    type: IMS
    bearer_bitmask: "14|18|20"
    protocol: IPV4V6
    roaming_protocol: IPV4V6
    user_visible: false
  }
  apn {
    name: "MTS BY XCAP"
    value: "xcap"
    type: XCAP
    protocol: IPV4V6
    roaming_protocol: IPV4V6
  }
}
configs {
  config { key: "carrier_volte_available_bool" bool_value: true }
  config { key: "carrier_wfc_ims_available_bool" bool_value: false }
  config { key: "show_4g_for_lte_data_icon_bool" bool_value: true }
  config { key: "hide_lte_plus_data_icon_bool" bool_value: false }
  config { key: "carrier_supports_ss_over_ut_bool" bool_value: true }
  config { key: "xcap_apn_name_string" text_value: "xcap" }
  config { key: "imsss.ut_as_server_fqdn_string" text_value: "xcap.ims.mnc002.mcc257.pub.3gppnetwork.org" }
  config { key: "bsf.bsf_server_fqdn_string" text_value: "bsf.mnc002.mcc257.pub.3gppnetwork.org" }
  config { key: "imsss.ut_as_server_port_int" int_value: 80 }
  config { key: "bsf.bsf_server_port_int" int_value: 8080 }
  config { key: "carrier_ussd_method_int" int_value: 1 }
}
