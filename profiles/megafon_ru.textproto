canonical_name: "megafon_ru"
version: 2
apns {
  apn {
    name: "Megafon RU Internet"
    value: "internet"
    type: DEFAULT
    type: SUPL
    user: "gdata"
    password: "gdata"
    authtype: 1
    protocol: IPV4V6
    roaming_protocol: IPV4V6
  }
  apn {
    name: "Megafon RU MMS"
    value: "mms"
    type: MMS
    user: "mms"
    password: "mms"
    authtype: 1
    mmsc: "http://mmsc:8002"
    mmsc_proxy: "10.10.10.10"
    mmsc_proxy_port: "8080"
    protocol: IP
    roaming_protocol: IP
  }
  apn {
    name: "Megafon RU IMS"
    value: "ims"
    type: IMS
    protocol: IPV4V6
    roaming_protocol: IPV4V6
    user_visible: false
  }
  apn {
    name: "Megafon RU XCAP"
    value: "hos"
    type: XCAP
    protocol: IPV4V6
    roaming_protocol: IPV4V6
    user_visible: false
  }
}
configs {
  config { key: "carrier_volte_available_bool" bool_value: true }
  config { key: "carrier_wfc_ims_available_bool" bool_value: true }
  config { key: "carrier_supports_ss_over_ut_bool" bool_value: true }
  config { key: "show_4g_for_lte_data_icon_bool" bool_value: true }
  config { key: "hide_lte_plus_data_icon_bool" bool_value: false }
  config { key: "imssms.sms_over_ims_supported_bool" bool_value: true }
  config { key: "carrier_ussd_method_int" int_value: 1 }
  config { key: "xcap_apn_name_string" text_value: "hos" }
  config { key: "iwlan.epdg_static_address_string" text_value: "epdg.epc.mnc002.mcc250.pub.3gppnetwork.org" }
  config { key: "iwlan.epdg_address_priority_int_array" int_array { value: 0 value: 1 } }
}
